.module "bench"
.entry 0

.import
  io.print_i64
  time.now

;; Internal timing via time.now() — same approach as bench.py.
;; Measures fib(30) × 10,000 wall-clock inside the VM.

.constants
  0 i64 30
  1 i64 0
  2 i64 1
  3 i64 10000

.callables
  0 io.print_i64
  1 time.now

.functions
  0 "main" regs=7
    ;; start = time.now()
    closure r1, 1, 0       ;; r1 = time.now
    call r1, 0, 1          ;; r1 = start ms

    loadk r6, 3            ;; r6 = 10000 (iterations)

    @outer:
    loadk r0, 0            ;; r0 = 30 (n)
    loadk r2, 1            ;; r2 = 0  (a)
    loadk r3, 2            ;; r3 = 1  (b)
    loadk r5, 2            ;; r5 = 1  (step, constant)

    @inner:
    jmpifnot r0, @done
    move r4, r2            ;; temp = a
    move r2, r3            ;; a = b
    add.i64 r3, r4, r3     ;; b = temp + b
    sub.i64 r0, r0, r5     ;; n--
    jmp @inner

    @done:
    sub.i64 r6, r6, r5     ;; iterations--
    jmpif r6, @outer

    ;; end = time.now()
    closure r0, 1, 0       ;; r0 = time.now
    call r0, 0, 1          ;; r0 = end ms

    ;; elapsed = end - start
    sub.i64 r0, r0, r1     ;; r0 = elapsed

    ;; print elapsed
    closure r4, 0, 0       ;; print_i64
    move r5, r0            ;; copy elapsed
    call r4, 1, 0

    ;; print result
    move r5, r2            ;; fib(30)
    call r4, 1, 0
    halt
  end
