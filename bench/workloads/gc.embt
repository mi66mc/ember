.module "gc"
.entry 0

.import
  core.alloc_gc
  core.gc_collect
  bench.consume

.constants
  0 i64 1
  1 i64 32
  2 i64 1000
  3 i64 42

.callables
  0 core.alloc_gc
  1 core.gc_collect
  2 bench.consume

.functions
  0 "main" regs=5
    loadk r4, 2
    @loop:
    closure r0, 0, 0
    loadk r1, 0
    loadk r2, 1
    call r0, 2, 1
    loadk r3, 3
    store.i64 r0, 0, r3
    loadk r0, 0
    closure r1, 1, 0
    call r1, 0, 0
    sub.i64 r4, r4, r0
    jmpif r4, @loop
    closure r0, 2, 0
    loadk r1, 2
    call r0, 1, 0
    halt
  end
