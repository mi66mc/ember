.module "sum-loop"
.version 1
.entry 0

.import
  io.print_i64

.constants
  0 i64 1
  1 i64 5
  2 i64 0

.callables
  0 function 1
  1 io.print_i64

.functions
  0 "main" regs=4
    closure r0, 0
    loadk r1, 1
    call r0, 1, 1
    closure r1, 1
    move r2, r0
    call r1, 1, 0
    halt
  end

  1 "sum_to" regs=5
    loadk r1, 0
    loadk r2, 2
    @loop:
    gt.i64 r3, r1, r0
    jmpif r3, @end
    add.i64 r2, r2, r1
    loadk r4, 0
    add.i64 r1, r1, r4
    jmp @loop
    @end:
    ret r2, 1
  end
