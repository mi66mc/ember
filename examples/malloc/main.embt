.module "malloc"
.entry 0

.import
  io.print_mem
  core.malloc
  core.memcpy
  core.free

;; Explicit manual memory management.
;; Allocates a buffer, copies data from constant section, prints, frees.

.constants
  0 bytes "hello from malloc"
  1 u64 17

.callables
  0 io.print_mem
  1 core.malloc
  2 core.memcpy
  3 core.free

.functions
  0 "main" regs=5
    ;; malloc(17) → ptr
    closure r0, 1, 0          ;; r0 = core.malloc
    loadk r1, 1               ;; size = 17
    call r0, 1, 1             ;; r0 = ptr

    ;; memcpy(dst, src, len)
    move r2, r0               ;; r2 = dst
    loadk r3, 0               ;; r3 = src ptr
    loadk r4, 1               ;; r4 = len
    closure r1, 2, 0          ;; r1 = core.memcpy
    call r1, 3, 0             ;; memcpy(r2, r3, r4)

    ;; print_mem(ptr, len)
    closure r1, 0, 0          ;; r1 = io.print_mem
    move r2, r0               ;; r2 = ptr
    loadk r3, 1               ;; r3 = len
    call r1, 2, 0

    ;; free(ptr)
    closure r1, 3, 0          ;; r1 = core.free
    move r2, r0               ;; r2 = ptr
    call r1, 1, 0

    halt
  end
