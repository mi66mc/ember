.module "tests"

;; Test module for `ember test` command.
;; Three test functions plus a main that prints a banner.

.import
  io.print_mem

.constants
  0 bytes "all tests"         ;; main banner text
  1 u64 9                     ;; length of banner
  2 i64 2                     ;; test_assert: multiplicand
  3 i64 3                     ;; test_assert: multiplier
  4 i64 6                     ;; test_assert: expected result
  5 i64 0                     ;; test_fail: divisor (zero)

.callables
  0 io.print_mem

.functions
  0 "main" regs=3
    closure r0, 0             ;; r0 = io.print_mem
    loadk r1, 0               ;; r1 = ptr to "all tests"
    loadk r2, 1               ;; r2 = 9 (len)
    call r0, 2, 0             ;; print_mem("all tests")
    halt
  end

  1 "test_simple" regs=1
    ;; always passes — just halts cleanly
    halt
  end

  2 "test_assert" regs=5
    ;; asserts that 2 * 3 == 6
    loadk r0, 2               ;; r0 = 2
    loadk r1, 3               ;; r1 = 3
    mul.i64 r2, r0, r1        ;; r2 = 2 * 3 = 6
    loadk r3, 4               ;; r3 = 6 (expected)
    eq.i64 r4, r2, r3         ;; r4 = (6 == 6) = 1 (true)
    jmpifnot r4, @fail        ;; jump to fail if assertion fails
    halt                      ;; assertion passed
  @fail:
    div.i64 r0, r0, r1        ;; intentional error on assertion failure
    halt
  end

  3 "test_fail" regs=2
    ;; intentional division by zero — always triggers a runtime error
    loadk r0, 5               ;; r0 = 0 (dividend)
    loadk r1, 5               ;; r1 = 0 (divisor)
    div.i64 r0, r0, r1        ;; division by zero → runtime error
    halt
  end
