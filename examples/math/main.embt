.module "math"
.entry 0

.import
  math.sqrt
  math.abs_i64
  io.print_f64
  io.print_i64

;; Demonstrates math.sqrt and math.abs_i64:
;;   sqrt(25.0) = 5.0
;;   abs(-42)   = 42

.constants
  0 f64 25.0                  ;; input for sqrt
  1 i64 -42                   ;; input for abs

.callables
  0 math.sqrt
  1 math.abs_i64
  2 io.print_f64
  3 io.print_i64

.functions
  0 "main" regs=4
    ;; --- sqrt(25.0) ---
    loadk r1, 0               ;; r1 = 25.0 (f64)
    closure r0, 0, 0           ;; r0 = math.sqrt
    call r0, 1, 1             ;; r0 = sqrt(25.0) = 5.0

    ;; print sqrt result
    closure r2, 2, 0           ;; r2 = io.print_f64
    move r3, r0               ;; r3 = 5.0
    call r2, 1, 0             ;; print_f64(5.0)

    ;; --- abs(-42) ---
    loadk r1, 1               ;; r1 = -42 (i64)
    closure r0, 1, 0           ;; r0 = math.abs_i64
    call r0, 1, 1             ;; r0 = abs(-42) = 42

    ;; print abs result
    closure r2, 3, 0           ;; r2 = io.print_i64
    move r3, r0               ;; r3 = 42
    call r2, 1, 0             ;; print_i64(42)

    halt
  end
