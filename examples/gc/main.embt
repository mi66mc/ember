.module "gc"
.entry 0

.import
  io.print_mem
  core.alloc_gc
  core.memcpy
  core.gc_collect

;; GC-managed allocation. Buffer is allocated on the GC heap,
;; used, then referenced dropped. GC collects it automatically.

.constants
  0 bytes "hello from gc"
  1 u64 14
  2 i64 1                   ;; type tag

.callables
  0 io.print_mem
  1 core.alloc_gc
  2 core.memcpy
  3 core.gc_collect

.functions
  0 "main" regs=5
    ;; alloc_gc(type_tag, size) → ptr
    closure r0, 1, 0          ;; r0 = core.alloc_gc
    loadk r1, 2               ;; type_tag = 1
    loadk r2, 1               ;; size = 14
    call r0, 2, 1             ;; r0 = ptr

    ;; memcpy(dst, src, len)
    move r2, r0               ;; r2 = dst
    loadk r3, 0               ;; r3 = src ptr
    loadk r4, 1               ;; r4 = len
    closure r1, 2, 0          ;; r1 = core.memcpy
    call r1, 3, 0             ;; memcpy(r2, r3, r4)

    ;; print_mem(ptr, len)
    closure r1, 0, 0          ;; r1 = io.print_mem
    move r2, r0               ;; r2 = ptr
    loadk r3, 1               ;; r3 = len
    call r1, 2, 0

    ;; Drop reference — overwrite r0
    loadk r0, 2               ;; r0 = 1 (type_tag)

    ;; Manual GC — sweeps the buffer
    closure r1, 3, 0          ;; r1 = core.gc_collect
    call r1, 0, 0

    halt
  end
