.module "arithmetic"
.version 1
.entry 0

.import
  io.print_i64

.constants
  0 i64 7
  1 i64 6
  2 i64 3

.callables
  0 io.print_i64

.functions
  0 "main" regs=5
    loadk r0, 0
    loadk r1, 1
    loadk r2, 2
    mul.i64 r3, r0, r1
    add.i64 r3, r3, r2
    closure r0, 0
    move r1, r3
    call r0, 1, 0
    halt
  end
