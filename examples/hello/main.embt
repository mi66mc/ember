.module "hello"
.entry 0

.import
  io.print_mem

;; Prints "hello from ember" by loading bytes into VM memory
;; and passing (ptr, len) to io.print_mem

.constants
  0 bytes "hello from ember"  ;; utf-8 string bytes (allocated on load)
  1 u64 16                    ;; string length

.callables
  0 io.print_mem

.functions
  0 "main" regs=3
    closure r0, 0             ;; r0 = io.print_mem
    loadk r1, 0               ;; r1 = ptr to "hello from ember"
    loadk r2, 1               ;; r2 = 16 (len)
    call r0, 2, 0             ;; print_mem(ptr=r1, len=r2)
    halt
  end
